  "interpretation": {
    "country": "manufacturer_assignment_country is copied from vPIC when supplied; it is not vehicle assembly country and is never inferred from the WMI prefix.",
    "manufacturer": "The manufacturer name is the vPIC assignment name; it is not a model, trim, engine, or automatic vehicle-model inference.",
    "vehicle_type": "vehicle_type is copied from vPIC. Only Passenger Car maps to the included class_scope passenger_car rule; MPV and truck remain year-cycle unresolved because vPIC WMI type alone does not establish the applicable GVWR class.",
    "check_digit": "Only a WMI present in the NHTSA vPIC Part 565 assignment subset enables a §565.15 check-digit comparison. A mismatch is a warning and never rejects a structurally valid VIN; an unknown WMI has unknown checksum scope.",
    "low_volume_wmi": "Six-character keys are copied only when explicitly returned by vPIC. A VIN with 9 in position 3 is looked up by positions 1-3 plus 12-14 and never falls back to a three-character key.",
    "runtime": "The decoder reads only this bundled CSV and does not issue network requests."
  }
